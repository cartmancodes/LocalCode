+def worker_command(executable: str, worker_module: str) -> list[str]:
+    """Use the bundled executable as a worker only for the production module."""
+    if getattr(sys, "frozen", False):
+        if worker_module != "backend.app.orchestrator.fleet.subproc":
+            raise ValueError(f"unsupported frozen worker module: {worker_module}")
+        return [executable, "--internal-fleet-worker", worker_module]
+    return [executable, "-m", worker_module]
+
